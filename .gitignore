.env
.venv/
__pycache__/

# macOS 系统文件
.DS_Store

# WorkBuddy 工作区数据：默认整体忽略
# （memory/ 是工作日志与会话记忆，含本机绝对路径与用户名，不进 public 仓库）
.workbuddy/*
# 例外：沉淀工作流 skill 随仓库走（纯工作流文档，不含个人信息）
!.workbuddy/skills/

# 测验构建/测试的临时产物（每次运行都会重新生成）
tools/_test.txt
tools/_render.txt
tools/_paths.txt
tools/_e2e.txt
tools/_sync.txt
tools/_layout.txt
# 一次性诊断脚本（下划线前缀即「临时」，不纳入版本管理）
tools/_diag.*
tools/_probe*

# 改造前的一次性备份（build.js 用它提取旧错题池顺序快照，勿删）
# 保留 .index.html.bak —— 迁移需要，见 tools/build.js
